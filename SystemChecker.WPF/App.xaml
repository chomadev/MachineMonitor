<Application x:Class="SystemChecker.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SystemChecker.WPF.Converters">
    <Application.Resources>
        <converters:MessageColorConverter x:Key="MessageColorConverter"/>
        <converters:ServiceStatusColorConverter x:Key="ServiceStatusColorConverter"/>
        <converters:ServiceRunningColorConverter x:Key="ServiceRunningColorConverter"/>
        <converters:ServiceRunningTextConverter x:Key="ServiceRunningTextConverter"/>
    </Application.Resources>
</Application> 