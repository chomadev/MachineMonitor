<Window x:Class="SystemChecker.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SystemChecker.WPF.Converters"
        xmlns:controls="clr-namespace:SystemChecker.WPF.Views.Controls"
        Title="System Checker" Height="750" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <converters:MessageColorConverter x:Key="MessageColorConverter"/>
        <converters:ServiceStatusColorConverter x:Key="ServiceStatusColorConverter"/>
        <converters:ServiceRunningColorConverter x:Key="ServiceRunningColorConverter"/>
        <converters:ServiceRunningTextConverter x:Key="ServiceRunningTextConverter"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Verificar Agora" 
                Command="{Binding CheckNowCommand}"
                Padding="10,5"
                HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="1" 
                   Text="{Binding LastCheckTime}"
                   Margin="0,5,0,10"
                   HorizontalAlignment="Right"
                   Foreground="Gray"
                   FontStyle="Italic"/>

        <TabControl Grid.Row="2">
            <TabItem Header="Serviços">
                <controls:ServicesTabControl DataContext="{Binding}"/>
            </TabItem>

            <TabItem Header="CPU/Memória">
                <controls:SystemResourcesTabControl DataContext="{Binding}"/>
            </TabItem>

            <TabItem Header="Configurações">
                <controls:ConfigurationTabControl DataContext="{Binding}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window> 