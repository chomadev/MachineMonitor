<Window x:Class="SystemChecker.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SystemChecker.WPF.Converters"
        xmlns:controls="clr-namespace:SystemChecker.WPF.Views.Controls"
        Title="System Checker" Height="850" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <converters:MessageColorConverter x:Key="MessageColorConverter"/>
        <converters:ServiceStatusColorConverter x:Key="ServiceStatusColorConverter"/>
        <converters:IsRunningColorConverter x:Key="IsRunningColorConverter"/>
        <converters:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Check Now" 
                Command="{Binding CheckNowCommand}"
                Padding="10,5"
                HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="1" 
                   Text="{Binding LastCheckTime}"
                   Margin="0,5,0,10"
                   HorizontalAlignment="Right"
                   Foreground="Gray"
                   FontStyle="Italic"/>

        <TabControl Grid.Row="2">
            <TabItem Header="Services">
                <controls:ServicesTabControl DataContext="{Binding ServicesViewModel}"/>
            </TabItem>

            <TabItem Header="System Resources">
                <controls:SystemResourcesTabControl DataContext="{Binding SystemResourcesViewModel}"/>
            </TabItem>
            
            <TabItem Header="Network">
                <controls:NetworkTabControl DataContext="{Binding NetworkViewModel, Mode=OneWay}"/>
            </TabItem>

            <TabItem Header="TCP Ports">
                <controls:TcpPortsControl DataContext="{Binding TcpPortsViewModel}"/>
            </TabItem>
            
            <TabItem Header="Folders">
                <controls:FolderMonitorTabControl DataContext="{Binding FolderMonitorViewModel}"/>
            </TabItem>

            <TabItem Header="Logs">
                <controls:LogsTabControl DataContext="{Binding LogsViewModel}"/>
            </TabItem>

            <TabItem Header="Settings">
                <controls:ConfigurationTabControl DataContext="{Binding}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window> 