<UserControl x:Class="SystemChecker.WPF.Views.Controls.LogsTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SystemChecker.WPF.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Controls Panel -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Level Filter -->
            <TextBlock Text="Level:" 
                      VerticalAlignment="Center"
                      Margin="0,0,5,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding LogLevels}"
                      SelectedItem="{Binding SelectedLogLevel}"
                      Width="120"
                      Margin="0,0,15,0"/>

            <!-- Search -->
            <TextBlock Grid.Column="2"
                      Text="Search:" 
                      VerticalAlignment="Center"
                      Margin="0,0,5,0"/>

            <TextBox Grid.Column="3"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      Padding="5,3"
                      VerticalAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Type to search in logs..." 
                                                          Foreground="Gray" 
                                                          FontStyle="Italic"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Clear Button -->
            <Button Grid.Column="4"
                    Content="Clear Logs"
                    Command="{Binding ClearLogsCommand}"
                    Margin="15,0,0,0"
                    Padding="10,5"/>
        </Grid>

        <!-- Logs List -->
        <ListView Grid.Row="1" 
                  ItemsSource="{Binding FilteredLogs}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}"
                                   VerticalAlignment="Top"
                                   Margin="0,5,10,0"/>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Level}"
                                   VerticalAlignment="Top"
                                   Margin="0,5,10,0"
                                   Foreground="{Binding Level, Converter={StaticResource LogLevelColorConverter}}"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,5,0,0">
                            <TextBlock Text="{Binding ShortMessage}" 
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Invert'}"/>
                            <TextBlock Text="{Binding FullMessage}" 
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="3" 
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Visibility="{Binding HasMoreDetails, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      VerticalAlignment="Top"
                                      Margin="10,0,0,0"
                                      Style="{StaticResource ExpandCollapseToggleStyle}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl> 