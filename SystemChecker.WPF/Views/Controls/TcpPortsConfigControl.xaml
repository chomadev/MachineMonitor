<UserControl x:Class="SystemChecker.WPF.Views.Controls.TcpPortsConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Monitored TCP Ports"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding TcpPorts}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Port"
                                  Binding="{Binding Port}"
                                  Width="*"/>
                <DataGridTextColumn Header="Process"
                                  Binding="{Binding ProcessName}"
                                  Width="*"
                                  IsReadOnly="True"/>
                <DataGridTextColumn Header="PID"
                                  Binding="{Binding ProcessId}"
                                  Width="100"
                                  IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="In Use"
                                      Binding="{Binding IsInUse}"
                                      Width="100"
                                      IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Save"
                    Command="{Binding SavePortsCommand}"
                    Padding="10,5"
                    Margin="0,0,10,0"/>
            <Button Content="Check Now"
                    Command="{Binding CheckPortsCommand}"
                    Padding="10,5"/>
        </StackPanel>
    </Grid>
</UserControl> 