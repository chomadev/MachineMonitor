<UserControl x:Class="SystemChecker.WPF.Views.Controls.FolderMonitorTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SystemChecker.WPF.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder Status -->
        <GroupBox Header="Folder Status" Margin="5">
            <DataGrid ItemsSource="{Binding FolderStatuses}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Path" 
                                      Binding="{Binding Path}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Status" 
                                      Binding="{Binding IsValid}"
                                      Width="80">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{Binding IsValid, Converter={StaticResource IsRunningColorConverter}}"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Last Modified" 
                                      Binding="{Binding LastModified, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}"
                                      Width="150"/>
                    <DataGridTextColumn Header="Empty" 
                                      Binding="{Binding IsEmpty}"
                                      Width="60"/>
                    <DataGridTextColumn Header="Zero Byte Files" 
                                      Binding="{Binding ZeroByteFiles.Count}"
                                      Width="100"/>
                    <DataGridTextColumn Header="Error" 
                                      Binding="{Binding ErrorMessage}"
                                      Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GridSplitter Grid.Row="1" 
                      Height="5" 
                      HorizontalAlignment="Stretch"
                      Background="LightGray"/>

        <!-- Folder Changes -->
        <GroupBox Header="Recent Changes" Grid.Row="2" Margin="5">
            <DataGrid ItemsSource="{Binding FolderChanges}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="5"
                      MaxHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Path" 
                                      Binding="{Binding Path}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Change Type" 
                                      Binding="{Binding LastChangeType}"
                                      Width="150"/>
                    <DataGridTextColumn Header="Changed At" 
                                      Binding="{Binding LastChanged, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}"
                                      Width="150"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastChangeType}" Value="Deleted">
                                <Setter Property="Background" Value="#FFEDED"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LastChangeType}" Value="Created">
                                <Setter Property="Background" Value="#EDFFED"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl> 