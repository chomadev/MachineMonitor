<UserControl x:Class="SystemChecker.WPF.Views.Controls.ConfigurationTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Schedule Configuration -->
        <GroupBox Header="Schedule" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                          Text="CRON Expression for Scheduling"
                          FontWeight="Bold"
                          Margin="0,0,0,5"/>

                <TextBox Grid.Row="1" 
                        Text="{Binding ConfigViewModel.CronExpression, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,5"/>

                <Button Grid.Row="2" 
                        Content="Validate Expression"
                        Command="{Binding ConfigViewModel.ValidateCronExpressionCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10"
                        Padding="10,5"/>

                <StackPanel Grid.Row="3" Margin="0,5">
                    <TextBlock Text="CRON expression examples:"/>
                    <TextBlock Text="*/15 * * * * = Every 15 minutes" Margin="10,2,0,0"/>
                    <TextBlock Text="0 * * * * = At the start of every hour" Margin="10,2,0,0"/>
                    <TextBlock Text="0 9-17 * * * = Every hour between 9 AM and 5 PM" Margin="10,2,0,0"/>
                    <TextBlock Text="0 9 * * * = Every day at 9 AM" Margin="10,2,0,0"/>
                    <TextBlock Text="0 9 * * 1-5 = Every weekday at 9 AM" Margin="10,2,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Services Configuration -->
        <GroupBox Header="Monitored Services" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBox Text="{Binding ConfigViewModel.NewServiceName, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Margin="0,0,5,0"/>
                    <Button Content="Add Service"
                            Command="{Binding ConfigViewModel.AddServiceCommand}"
                            Padding="10,5"/>
                </StackPanel>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding ConfigViewModel.MonitoredServices}"
                         SelectedItem="{Binding ConfigViewModel.SelectedService}"
                         MinHeight="100"
                         Margin="0,5"/>

                <Button Grid.Row="2" 
                        Content="Remove Selected Service"
                        Command="{Binding ConfigViewModel.RemoveServiceCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,5,0,0"
                        Padding="10,5"/>
            </Grid>
        </GroupBox>

        <!-- TCP Ports Configuration -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="TCP Ports to Monitor (comma separated):" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ConfigViewModel.TcpPorts, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter port numbers separated by commas (e.g.: 80,443,3389)"/>
        </StackPanel>

        <!-- IP Addresses Configuration -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="IP Addresses to Monitor (comma separated):" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ConfigViewModel.MonitoredIpAddresses, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter IP addresses separated by commas (e.g.: 8.8.8.8,1.1.1.1)"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Vertical">
            <TextBlock Text="{Binding ConfigViewModel.ValidationMessage}"
                      Foreground="{Binding ConfigViewModel.ValidationMessage, Converter={StaticResource MessageColorConverter}}"
                      TextWrapping="Wrap"
                      Margin="0,0,0,10"/>
            
            <Button Content="Save Settings"
                    Command="{Binding ConfigViewModel.SaveCommand}"
                    HorizontalAlignment="Right"
                    Padding="20,5"/>
        </StackPanel>
    </Grid>
</UserControl> 