<UserControl x:Class="SystemChecker.WPF.Views.Controls.TcpPortsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DataGrid ItemsSource="{Binding TcpPortStatuses}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}"/>
                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding IsOpen}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl> 