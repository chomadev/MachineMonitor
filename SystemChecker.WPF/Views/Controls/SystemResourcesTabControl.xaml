<UserControl x:Class="SystemChecker.WPF.Views.Controls.SystemResourcesTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CPU -->
        <GroupBox Header="CPU" Margin="5">
            <StackPanel Margin="5">
                <TextBlock>
                    <Run Text="Uso: "/>
                    <Run Text="{Binding LastCheck.Cpu.UsagePercentage, StringFormat='{}{0:N1}%'}"/>
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- Memória -->
        <GroupBox Header="Memória" Grid.Row="1" Margin="5">
            <StackPanel Margin="5">
                <TextBlock>
                    <Run Text="Total: "/>
                    <Run Text="{Binding LastCheck.Memory.TotalPhysicalMemory, StringFormat='{}{0:N0} MB'}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Disponível: "/>
                    <Run Text="{Binding LastCheck.Memory.AvailablePhysicalMemory, StringFormat='{}{0:N0} MB'}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Uso: "/>
                    <Run Text="{Binding LastCheck.Memory.UsagePercentage, StringFormat='{}{0:N1}%'}"/>
                </TextBlock>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl> 