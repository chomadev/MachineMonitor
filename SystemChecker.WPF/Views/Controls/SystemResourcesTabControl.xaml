<UserControl x:Class="SystemChecker.WPF.Views.Controls.SystemResourcesTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SystemChecker.WPF.Converters">
    <UserControl.Resources>
        <converters:BytesToGigabytesConverter x:Key="BytesToGigabytesConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CPU -->
            <GroupBox Header="CPU" Margin="5">
                <StackPanel Margin="5">
                    <TextBlock>
                        <Run Text="Usage: "/>
                        <Run Text="{Binding Cpu.UsagePercentage, StringFormat='{}{0:N1}%'}"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- Memory -->
            <GroupBox Header="Memory" Grid.Row="1" Margin="5">
                <StackPanel Margin="5">
                    <TextBlock>
                        <Run Text="Total: "/>
                        <Run Text="{Binding Memory.TotalPhysicalMemory, Converter={StaticResource BytesToGigabytesConverter}, StringFormat='{}{0:N0} GB'}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Available: "/>
                        <Run Text="{Binding Memory.AvailablePhysicalMemory, Converter={StaticResource BytesToGigabytesConverter}, StringFormat='{}{0:N0} GB'}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Usage: "/>
                        <Run Text="{Binding Memory.UsagePercentage, StringFormat='{}{0:N1}%'}"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- Disks -->
            <GroupBox Header="Disks" Grid.Row="2" Margin="5">
                <ItemsControl ItemsSource="{Binding Disks}" Margin="5">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" 
                                    BorderThickness="0,0,0,1" 
                                    Margin="0,5">
                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" FontWeight="SemiBold">
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>

                                    <Grid Grid.Row="1" Margin="10,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Space: " Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalSpace, Converter={StaticResource BytesToGigabytesConverter}, StringFormat='{}{0:N2} GB'}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Free Space: " Margin="0,0,10,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FreeSpace, Converter={StaticResource BytesToGigabytesConverter}, StringFormat='{}{0:N2} GB'}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Usage: " Margin="0,0,10,0"/>
                                        <ProgressBar Grid.Row="2" Grid.Column="1" 
                                                   Height="15" 
                                                   Maximum="100"
                                                   Value="{Binding UsagePercentage}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsagePercentage}" Value="90">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsagePercentage}" Value="75">
                                                            <Setter Property="Foreground" Value="Orange"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                                 Text="{Binding UsagePercentage, StringFormat='{}{0:N1}%'}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl> 